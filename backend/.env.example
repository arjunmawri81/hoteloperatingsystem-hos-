# Server
PORT=5000
NODE_ENV=production
APP_URL=https://your-backend-service.onrender.com
CLIENT_URL=https://your-frontend-app.vercel.app
API_PREFIX=/api

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hos?retryWrites=true&w=majority
MONGO_DB_NAME=hos

# Auth (JWT Secrets)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=your_otp_secret_key
OTP_EXPIRES_IN=300
