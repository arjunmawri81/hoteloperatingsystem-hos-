# Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
API_PREFIX=/api
SWAGGER_PATH=/api/docs

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/hos
MONGO_DB_NAME=hos

# Cache and Queue (Redis / BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Auth (JWT, Refresh Token, OTP, MFA)
JWT_SECRET=hos_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=hos_super_secret_refresh_token_key_2026
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=hos_otp_secret_key_2026
OTP_EXPIRES_IN=300
MFA_APP_NAME="HOS Hotel System"

# Real-Time WebSocket
WS_PORT=5001
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# File Storage (Google Cloud Storage)
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
GCS_BUCKET_NAME=
GCS_STORAGE_BASE_URL=https://storage.googleapis.com

# AI and LLMs (OpenAI / Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
LLM_PROVIDER=openai

# AI Calling (Vapi / OmniDimension)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
OMNIDIMENSION_API_KEY=
OMNIDIMENSION_AGENT_ID=

# Mobile Push Notifications (Firebase FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FLUTTER_APP_ID=com.meridian.hos

# WhatsApp and SMS (Twilio / Meta)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# Email (SMTP / SendGrid / Resend)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@meridianhotels.com
SMTP_FROM_NAME="Meridian Hospitality Group"
SENDGRID_API_KEY=
RESEND_API_KEY=

# Cloud Monitoring and GCP
GOOGLE_APPLICATION_CREDENTIALS=
SENTRY_DSN=
LOG_LEVEL=debug
